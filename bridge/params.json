{
  "tmux_prefix": "bridge",
  "poll_s": 0.5,
  "timeout_s": 300,
  "startup_s": 3,
  "paste_settle_s": 0.3,
  "harnesses": {
    "pi": {
      "bin": "pi",
      "args": [
        "--provider",
        "llama-local",
        "--model",
        "gemma-4-26B-A4B-it-UD-Q3_K_M.gguf",
        "--thinking",
        "off"
      ]
    },
    "codex": {
      "bin": "codex",
      "args": [
        "-a",
        "never",
        "-s",
        "workspace-write"
      ]
    },
    "agy": {
      "bin": "agy",
      "args": [
        "--dangerously-skip-permissions"
      ]
    },
    "opencode": {
      "bin": "opencode",
      "args": [
        "--auto"
      ],
      "startup_s": 9
    }
  },
  "stable_s": 1.5,
  "report_open": "BEGIN_REPORT",
  "report_close": "END_REPORT",
  "report_instruction": "\n\nWhen done, end your reply with your final report for the caller between a line \"BEGIN_REPORT\" and a line \"END_REPORT\". Only that part is returned.",
  "fallback_chars": 1500,
  "submit_retries": 1,
  "submit_check_s": 3,
  "echo_probe_chars": 40
}
